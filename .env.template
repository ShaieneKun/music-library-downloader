# Copy to .env and edit.

# YouTube Music playlist(s) to mirror (space or comma separated)
PLAYLIST_URL=https://music.youtube.com/playlist?list=YOUR_PLAYLIST_ID

# How often to check the playlist for new songs
INTERVAL_SECONDS=3600

# Host directory where songs are saved (created if missing).
# Default: Music folder in your home directory. Use an absolute path.
# MUSIC_DIR=/Users/you/Music
# Songs downloaded in parallel, and the minimum pause (seconds) between song
# download starts across all workers.
DOWNLOAD_WORKERS=4
DOWNLOAD_SLEEP_SECONDS=2
# Extra attempts per song after a transient error (HTTP 403/429/5xx, timeouts).
DOWNLOAD_RETRIES=2

# Keep yt-dlp up to date automatically (YouTube breaks old versions often)
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_INTERVAL_SECONDS=86400

# Each cycle writes a DEBUG run log (cycle-*.log) with a summary of what was
# found/downloaded/uploaded. Cycles where nothing happened are discarded
# unless LOG_KEEP_IDLE=true. Old run logs are deleted after LOG_RETENTION_DAYS.
LOG_KEEP_IDLE=false
LOG_RETENTION_DAYS=14

# Name shown in the cycle summary. Inside a container the hostname is a random
# id, so set the real one, e.g. HOST_HOSTNAME=$(hostname) in your shell or here.
# HOST_HOSTNAME=my-server

# --- Google Drive upload (optional, see README) ---
DRIVE_UPLOAD_ENABLED=false
# Folder in My Drive (created if missing). "Music/Auto" creates nested folders.
DRIVE_FOLDER_NAME=Music Library Downloader
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false (default): download every playlist song missing locally, even if it is
# already in Drive (it is not uploaded again). true: skip songs already uploaded.
SKIP_DOWNLOAD_IF_UPLOADED=false
# Remove the local copy once it is safely in Drive
DELETE_AFTER_UPLOAD=false
