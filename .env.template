# Copy to .env and edit.

# YouTube Music playlist(s) to mirror (space or comma separated)
PLAYLIST_URL=https://music.youtube.com/playlist?list=YOUR_PLAYLIST_ID

# How often to check the playlist for new songs
INTERVAL_SECONDS=3600

# Host directory where songs are saved (created if missing).
# Default: Music folder in your home directory. Use an absolute path.
# MUSIC_DIR=/Users/you/Music

# --- Google Drive upload (optional, see README) ---
DRIVE_UPLOAD_ENABLED=false
# Folder in My Drive (created if missing). "Music/Auto" creates nested folders.
DRIVE_FOLDER_NAME=Music Library Downloader
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false (default): download every playlist song missing locally, even if it is
# already in Drive (it is not uploaded again). true: skip songs already uploaded.
SKIP_DOWNLOAD_IF_UPLOADED=false
# Remove the local copy once it is safely in Drive
DELETE_AFTER_UPLOAD=false
