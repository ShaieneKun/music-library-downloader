# Directory to save songs to. Takes priority over the CLI argument.
# Inside the container this is a container path (the compose volume mounts ./auto-downloaded-songs at /app/auto-downloaded-songs).
DESTINATION_FOLDER=

# Playlists to sync, separated by commas or whitespace. Defaults to the playlist in src/download_songs.py.
PLAYLIST_URLS=

# Seconds between download runs. Defaults to 3600.
DOWNLOAD_INTERVAL_SECONDS=
